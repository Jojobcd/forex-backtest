#!/bin/sh
# Bloque un commit qui contiendrait une clé, un jeton ou un fichier secret.
# Installation : cp outils/pre-commit .git/hooks/pre-commit
# Contournement volontaire (déconseillé) : git commit --no-verify

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

bad_names=$(printf '%s\n' "$files" | grep -E -i '(^|/)\.env($|\.)|\.pem$|\.key$|\.p12$|credentials.*\.json$|journal_forex_sauvegarde_.*\.json$')
if [ -n "$bad_names" ]; then
  echo "COMMIT BLOQUÉ : fichier sensible ajouté :"
  printf '  %s\n' $bad_names
  exit 1
fi

pattern='(api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|password|passwd)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_\-]{12,}|sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached -U0 -- $files | grep -E '^\+' | grep -v '^+++' | grep -E -i -n "$pattern")
if [ -n "$hits" ]; then
  echo "COMMIT BLOQUÉ : ce qui ressemble à une clé ou un mot de passe a été trouvé :"
  printf '%s\n' "$hits" | cut -c1-120
  echo "Mettez la valeur dans un fichier .env (ignoré par git) et relancez le commit."
  exit 1
fi
exit 0
